{
  "name": "playwright-mcp-demo",
  "version": "1.0.0",
  "description": "Local e-commerce demo app for Playwright MCP test automation",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only backend/src/index.ts",
    "build": "tsc",
    "seed": "node scripts/seed.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:bdd": "TS_NODE_PROJECT=tests/bdd/tsconfig.json cucumber-js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.7.0",
    "@playwright/test": "^1.41.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "playwright": "^1.58.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
